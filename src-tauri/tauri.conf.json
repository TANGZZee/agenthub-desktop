{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub Desktop",
  "version": "0.1.0",
  "identifier": "com.agenthub.desktop",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub Desktop",
        "width": 1100,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/test-agent.js": "scripts/test-agent.js",
      "../scripts/env-dump.js": "scripts/env-dump.js",
      "../sidecar/dist/sidecar.cjs": "sidecar/dist/sidecar.cjs",
      "../config/agents.json": "config/agents.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
