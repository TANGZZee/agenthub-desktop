{
  // AgentHub Desktop 中央配置。
  // 修改这个文件后不需要重启应用，启动 Agent 时会自动检查并重新加载。
  //
  // 路径规则：
  // - cwd 相对于本文件所在目录解析；".." 表示项目根目录。
  // - command 和 args 原样交给系统启动，args 里的相对路径由 cwd 决定。
  //
  // 说明：启动任务字段在协议里叫 prompt，不叫 task。
  // task 将留给阶段3的调度功能，避免两个同名概念混淆。

  "agents": {
    "hermes": {
      "label": "Hermes（大管家·安全占位）",
      "command": "C:/Users/Tang/AppData/Local/hermes/bin/hermes.exe",
      "enabled": false,
      "args": [],
      "default_model": "balanced",
      "cwd": "..",
      // 仅用于测试/演示：把“正在启动”或“正在终止”状态延长指定毫秒数。
      // 日常使用请保持 0，否则启动和终止会明显变慢。
      "start_delay_ms": 0,
      "stop_delay_ms": 0
    },
    "pi": {
      "label": "Pi（后台 Worker）",
      "command": "D:/DevTools/pi-cli/node_modules/.bin/pi.cmd",
      "args": [],
      "default_model": "fast",
      "cwd": "..",
      "start_delay_ms": 0,
      "stop_delay_ms": 0
    },
    "claude": {
      "label": "Claude Code（暂不可用）",
      "command": "D:/DevTools/claude-cli/node_modules/.bin/claude.cmd",
      "enabled": false,
      "args": [],
      "default_model": "powerful",
      "cwd": "..",
      "start_delay_ms": 0,
      "stop_delay_ms": 0
    },
    "codex": {
      "label": "Codex（后台 Worker）",
      "command": "C:/Users/Tang/AppData/Local/OpenAI/Codex/bin/bffc5354119c8421/codex.exe",
      "args": [],
      "default_model": "balanced",
      "cwd": "..",
      "start_delay_ms": 0,
      "stop_delay_ms": 0
    }
  },

  // 模型别名是“给用户看的档次”，右侧才是真正注入给 Agent 的模型名。
  // 某个 Agent 没有配某档时，它的下拉里不会出现那一档。
  "model_aliases": {
    "fast": {
      "claude": "glm-4-flash",
      "codex": "deepseek-v4-flash",
      "pi": "haiku",
      "hermes": "haiku"
    },
    "balanced": {
      "claude": "glm-5.3",
      "codex": "qwen3-coder",
      "pi": "sonnet",
      "hermes": "sonnet"
    },
    "powerful": {
      "claude": "glm-5.3",
      "codex": "doubao-seed-code",
      "pi": "opus",
      "hermes": "opus"
    }
  },

  // 环境变量模板。可用占位符：
  // {model}     -> 上面别名解析出的真实模型名
  // {base_url}  -> cc_switch.base_url
  // {api_key}   -> 系统环境变量 api_key_env 的值
  "env_injection": {
    "hermes": {
      "ANTHROPIC_BASE_URL": "{base_url}",
      "ANTHROPIC_AUTH_TOKEN": "{api_key}",
      "ANTHROPIC_MODEL": "{model}"
    },
    "pi": {
      "ANTHROPIC_BASE_URL": "{base_url}",
      "ANTHROPIC_AUTH_TOKEN": "{api_key}",
      "ANTHROPIC_MODEL": "{model}"
    },
    "claude": {
      "ANTHROPIC_BASE_URL": "{base_url}",
      "ANTHROPIC_AUTH_TOKEN": "{api_key}",
      "ANTHROPIC_MODEL": "{model}"
    },
    "codex": {
      "OPENAI_BASE_URL": "{base_url}",
      "OPENAI_API_KEY": "{api_key}",
      "OPENAI_MODEL": "{model}"
    }
  },

  // CC Switch 需要由用户自行启动并配置路由。
  // 阶段2只把地址和密钥注入给 Agent，不会主动发送模型请求。
  "cc_switch": {
    "base_url": "http://127.0.0.1:8787",
    "api_key_env": "CC_SWITCH_API_KEY"
  }
}
